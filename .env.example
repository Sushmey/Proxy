# Copy this file to .env and fill it in. .env is gitignored; never commit it.
# Real environment variables override anything set here.
# A blank value means "use the default".

# ---------------------------------------------------------------------------
# Email channel (email_scheduler.py and inbox search)
# ---------------------------------------------------------------------------

# Where due reminders are emailed. If blank, reminders are NOT sent (and not
# deleted), and email_scheduler.py says so at startup.
REMINDER_EMAIL=

# The agent's own mailbox. Its auto-replies are hidden from inbox searches so
# they don't show up as "context". Leave blank if you don't have one.
AGENT_EMAIL=

# Word an email must start with for the agent to act on it. Not a secret.
EMAIL_TRIGGER=@agent

# ---------------------------------------------------------------------------
# Model (llm_client.py)
# ---------------------------------------------------------------------------

# Which backend to use:
#   ollama             a local Ollama server (default, nothing leaves your machine)
#   openai_compatible  OpenAI, OpenRouter, Groq, Together, vLLM, LM Studio, ...
#   anthropic          Claude, through Anthropic's package: pip install anthropic
LLM_PROVIDER=ollama

# Model name as the provider knows it. Blank = the provider's default:
#   ollama             gpt-oss:20b   (any local model that supports tools)
#   openai_compatible  gpt-oss:20b   (set this to your provider's model id)
#   anthropic          claude-opus-5-5   (claude-sonnet-5-5 is the cheaper option)
LLM_MODEL=

# Where the API lives. Blank = the provider's default:
#   ollama             http://localhost:11434
#   openai_compatible  https://api.openai.com/v1
#   anthropic          Anthropic's own endpoint (leave blank)
LLM_BASE_URL=

# API key for hosted providers. Leave blank for a local Ollama server.
# For anthropic, blank falls back to ANTHROPIC_API_KEY in your environment.
# A hosted provider receives your calendar and email text, so only set this
# if you are comfortable with that.
LLM_API_KEY=

# Optional, Ollama only: context window in tokens. If replies get cut off
# mid-sentence, raise this (e.g. 16384); it uses more memory.
LLM_NUM_CTX=

# Optional, anthropic only: longest reply in tokens (default 16000).
LLM_MAX_TOKENS=
